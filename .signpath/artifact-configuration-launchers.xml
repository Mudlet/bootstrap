<?xml version="1.0" encoding="utf-8"?>
<!-- GitHub Actions packages artifacts as ZIP files, so zip-file is the root element -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <!-- One launcher per game in GameList.txt, all built from the same source
         and gathered into a single artifact by CI/prepare-signing-win.sh, so
         the whole list is covered by one signing request -->
    <pe-file path="MudletInstaller-*.exe">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
