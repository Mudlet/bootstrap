#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @LAUNCHER_VERSION_MAJOR@,@LAUNCHER_VERSION_MINOR@,@LAUNCHER_VERSION_PATCH@,0
PRODUCTVERSION @LAUNCHER_VERSION_MAJOR@,@LAUNCHER_VERSION_MINOR@,@LAUNCHER_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName", "Mudlet"
      VALUE "FileDescription", "MudletInstaller"
      VALUE "FileVersion", "@LAUNCHER_VERSION@.0"
      VALUE "InternalName", "MudletInstaller"
      VALUE "OriginalFilename", "MudletInstaller.exe"
      VALUE "ProductName", "MudletInstaller"
      VALUE "ProductVersion", "@LAUNCHER_VERSION@.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
